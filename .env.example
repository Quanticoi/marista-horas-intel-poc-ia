# Gerado localmente pelos scripts; não versionar .env real.
POSTGRES_PASSWORD=
MIGRATION_PASSWORD=
APP_PASSWORD=
READONLY_PASSWORD=
MLFLOW_PASSWORD=
# RustFS console (http://127.0.0.1:9001), login por chave:
# Access Key / usuario = AWS_ACCESS_KEY_ID
# Secret Key / senha = AWS_SECRET_ACCESS_KEY
# Nomes AWS porque MLflow/boto3 usam a API S3; nao exige conta AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RABBITMQ_PASSWORD=
API_TOKEN=
# Credencial separada para aprovar/revogar versoes, nunca exibida no notebook.
OPERATOR_TOKEN=
DASHBOARD_TOKEN=
JUPYTER_TOKEN=
INFERENCE_TOKEN=
MONITOR_TOKEN=
INGESTION_TOKEN=
# Configuracao publica; compartilhada entre Jupyter, API e inferencia.
MLFLOW_EXPERIMENT_NAME=planilha-turmas-proxy-v1
# Notebook09/10: selecao explicita opcional; contexto08 tem prioridade sobre procura na lista.
PROPOSAL_ID=
# V4: configuracoes publicas centralizadas em deployment/scripts/generate_compose.py:
# SOURCE_DATABASE_URL: PostgreSQL planejamento_db, usuario somente leitura.
# APPLICATION_DATABASE_URL: mesmo banco, usuario planning_app.
# As URLs sao compostas com os segredos acima dentro do Compose; nunca copiar para notebooks.
# MLFLOW_TRACKING_URI=http://mlflow:5000 (rede interna)
# MLFLOW_UI_BASE_URL=http://127.0.0.1:5000 (navegador)
# API_URI=http://api:8000; INFERENCE_URI=http://inference:8001
# MLFLOW_OPERATIONS_EXPERIMENT_NAME=HI/POC/Operations/V4
# Experimento cientifico: HI/POC/PlanilhaTurmas/academic-components/<ciclo>
# Modelo V4: hi.demo.v4.c<course_code>.components
# JOURNEY_TIMEOUT=15; JOURNEY_RETRIES=2; MLFLOW_HTTP_REQUEST_TIMEOUT=15
