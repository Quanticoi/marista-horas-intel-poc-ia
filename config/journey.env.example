# Non-secret Compose defaults; endpoints inside containers differ from browser URLs.
# SQL credentials come from the existing .env (not versioned). URI-encode special
# characters if supplying a complete URL. Never paste actual URLs into notebook output.
SOURCE_DATABASE_URL=postgresql+psycopg://planning_readonly:<encoded-password>@postgres:5432/planejamento_db
APPLICATION_DATABASE_URL=postgresql+psycopg://planning_app:<encoded-password>@postgres:5432/planejamento_db
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_UI_BASE_URL=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=planilha-turmas-proxy-v1
MODEL_NAME=planilha-turmas-demo
API_URI=http://api:8000
INFERENCE_URI=http://inference:8001
JOURNEY_MODE=DEMO
JOURNEY_CYCLE=2026-1
JOURNEY_COURSE=
JOURNEY_TIMEOUT=15
JOURNEY_RETRIES=2
# MLflow writes artifacts; Jupyter uses S3 read access only for checksum evidence.
MLFLOW_S3_ENDPOINT_URL=http://rustfs:9000
S3_BUCKET=pucpr-poc
